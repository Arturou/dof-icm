# DOF-ICM gitignore

# Corpus is generated by scripts (download + convert) — too big to commit.
# Ship scripts/download.sh + scripts/convert.sh instead; users build their own.
dof-icm/corpus/
!dof-icm/corpus/index/.gitkeep

# Working artifacts — per-run outputs, never committed
dof-icm/stages/*/output/*
!dof-icm/stages/*/output/.gitkeep

# Eval run results
dof-icm/eval/results/*
!dof-icm/eval/results/.gitkeep

# Setup config (may contain local preferences)
dof-icm/setup/config.md

# Logs
dof-icm/*.log

# DOF-ICM gitignore
# NOTE: this file lives in dof-icm/, so patterns are relative to dof-icm/.

# Corpus is generated by scripts (download + convert) — too big to commit.
# Ship scripts/setup.sh instead; users build their own corpus.
corpus/
!corpus/index/.gitkeep

# Conversion leftovers: quarantined HTML junk + retained failures
dof_failed/
!dof_failed/.gitkeep

# Working artifacts — per-run outputs, never committed
stages/*/output/*
!stages/*/output/.gitkeep

# Eval run results
eval/results/*
!eval/results/.gitkeep

# Setup config (may contain local preferences)
setup/config.md

# Logs
*.log
